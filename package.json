{
  "name": "@neverending/renameit",
  "version": "1.0.9",
  "description": "Cross-platform batch file renaming utility",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falkorclark/renameit.git"
  },
  "homepage": "https://falkorclark.github.io/renameit/",
  "bin": {
    "renameit": "lib/bin/cli.js"
  },
  "module": "./lib/renameit.js",
  "main": "./lib/renameit.js",
  "types": "./lib/renameit.d.ts",
  "exports": {
    ".": "./lib/renameit.js",
    "./lib/*.js": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "docs",
    "lib",
    "markdown"
  ],
  "scripts": {
    "start": "node --import tsx src/bin/cli.ts",
    "build": "node --import tsx src/bin/build.ts",
    "test": "npx eslint src --quiet && node --import tsx src/bin/test.ts"
  },
  "author": "Falkor Clark <falkorclark@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "batch",
    "file",
    "rename",
    "batch rename",
    "file rename"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@neverending/markugen": "^2.0.11",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "@types/yargs": "^17.0.35",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "colors": "^1.4.0",
    "fs-extra": "^11.4.1",
    "yargs": "^18.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
